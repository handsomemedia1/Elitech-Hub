{
    "version": 2,
    "builds": [
        {
            "src": "backend/api/index.js",
            "use": "@vercel/node"
        }
    ],
    "crons": [
        {
            "path": "/api/health",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/admin/cron/remind-writers",
            "schedule": "0 9 * * *"
        },
        {
            "path": "/api/admin/cron/check-missed-posts",
            "schedule": "0 20 * * *"
        }
    ],
    "redirects": [
        {
            "source": "/",
            "destination": "https://elitechub.com",
            "permanent": true
        },
        {
            "source": "/((?!api).*)",
            "destination": "https://elitechub.com/$1",
            "permanent": true
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/backend/api/index.js"
        }
    ]
}